# Backend-managed provider keys.
GEMINI_API_KEY=
OPENAI_API_KEY=

# Optional deployment port convention for your host/platform:
PORT=8010

# `python main.py` binds to 127.0.0.1 by default. Set THINKTANK_HOST to expose it
# (e.g. 0.0.0.0), or THINKTANK_DEV=1 to enable auto-reload and listen on 0.0.0.0.
THINKTANK_HOST=
THINKTANK_DEV=

# Shared access token required on /api/* (except /api/health) when set.
# Set this before exposing the server beyond localhost.
THINKTANK_ACCESS_TOKEN=

# Comma-separated proxy IPs/CIDRs whose X-Forwarded-For header is trusted for rate limiting.
THINKTANK_TRUSTED_PROXIES=

# Comma-separated origins allowed to call the API during development/deployment.
THINKTANK_ALLOWED_ORIGINS=http://127.0.0.1:5173,http://localhost:5173,http://127.0.0.1:8010,http://localhost:8010

# Security guardrails for expensive provider-backed endpoints.
THINKTANK_MAX_REQUEST_BYTES=65536
THINKTANK_VALIDATE_RATE_LIMIT=20
THINKTANK_VALIDATE_RATE_WINDOW_SECONDS=60
THINKTANK_DEBATE_RATE_LIMIT=6
THINKTANK_DEBATE_RATE_WINDOW_SECONDS=60
THINKTANK_RATE_LIMIT_MAX_KEYS=10000
